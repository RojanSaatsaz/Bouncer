{
  "name": "bouncer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "migrate:prod": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test:message": "tsx --env-file=.env scripts/test-message.ts",
    "test:call": "tsx --env-file=.env scripts/test-call.ts",
    "test:chat": "tsx --env-file=.env scripts/test-chat.ts",
    "test:postcall": "tsx --env-file=.env scripts/test-postcall.ts",
    "test:setup": "tsx --env-file=.env scripts/test-setup.ts",
    "test:patterns": "tsx --env-file=.env scripts/test-patterns.ts",
    "test:recovery": "tsx --env-file=.env scripts/test-recovery.ts",
    "seed:family": "tsx --env-file=.env scripts/seed-family.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "eval:archive": "tsx --env-file=.env scripts/eval-archive.ts",
    "eval:calls": "tsx --env-file=.env scripts/eval-calls.ts",
    "replay": "tsx --env-file=.env scripts/replay.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@hono/node-server": "^1.13.0",
    "@photon-ai/api": "^0.6.0",
    "hono": "^4.6.0",
    "libphonenumber-js": "^1.12.10",
    "p-limit": "^7.3.0",
    "pg": "^8.13.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
